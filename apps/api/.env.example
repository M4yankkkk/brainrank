NODE_ENV=development
PORT=8080

# Supabase Postgres, via the session/transaction pooler, using a role that owns
# the tables (e.g. the default `postgres` role) so it bypasses RLS.
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# https://<project-ref>.supabase.co - used to verify client access tokens via
# Supabase's JWKS and to build the Storage admin client.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Shared secret Render Cron Jobs send as the `x-cron-secret` header when
# calling /internal/cron/* routes. Generate with `openssl rand -hex 32`.
CRON_SECRET=replace-with-a-long-random-secret

WEB_ORIGIN=http://localhost:3000
