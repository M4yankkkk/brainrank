# Used only for Supabase Auth sign-in (Google + email magic link). No app
# data is ever read/written through these - see NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# The Fastify API (apps/api) that owns all business logic.
NEXT_PUBLIC_API_URL=http://localhost:8080
