{
  "color": {
    "light": {
      "bg": "#E9EBF1",
      "tray": "#DFE2EA",
      "card": "#FFFFFF",
      "ink": "#1B1E31",
      "ink2": "#5B6078",
      "line": "#D3D7E2",
      "edge": "rgba(27,30,49,0.10)",
      "violet": "#7E62F0",
      "violetDeep": "#5B41C9",
      "violetSoft": "#EEE9FF",
      "orange": "#FF7F36",
      "orangeDeep": "#D95E17",
      "orangeSoft": "#FFEEE3",
      "teal": "#14A89B",
      "tealDeep": "#0C8076",
      "tealSoft": "#DDF5F2",
      "sun": "#FFC23D",
      "good": "#2FB36B"
    },
    "dark": {
      "bg": "#141728",
      "tray": "#1B1F34",
      "card": "#232842",
      "ink": "#F1F2F8",
      "ink2": "#A3A8C3",
      "line": "#30365A",
      "edge": "rgba(0,0,0,0.35)",
      "violet": "#7E62F0",
      "violetDeep": "#5B41C9",
      "violetSoft": "#2E2758",
      "orange": "#FF7F36",
      "orangeDeep": "#D95E17",
      "orangeSoft": "#3B2A24",
      "teal": "#14A89B",
      "tealDeep": "#0C8076",
      "tealSoft": "#173A3A",
      "sun": "#FFC23D",
      "good": "#2FB36B"
    }
  },
  "puzzle": {
    "starfield": { "signature": "violet", "base": "violet", "deep": "violetDeep", "soft": "violetSoft" },
    "shiftword": { "signature": "orange", "base": "orange", "deep": "orangeDeep", "soft": "orangeSoft" },
    "unblock": { "signature": "teal", "base": "teal", "deep": "tealDeep", "soft": "tealSoft" }
  },
  "font": {
    "display": "'Bricolage Grotesque', 'Plus Jakarta Sans', system-ui, sans-serif",
    "ui": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap",
    "weight": {
      "displaySemibold": 600,
      "displayBold": 800,
      "uiRegular": 400,
      "uiMedium": 500,
      "uiSemibold": 600,
      "uiBold": 700
    }
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "14px",
    "lg": "16px",
    "xl": "22px",
    "pill": "999px"
  },
  "spacing": {
    "appPaddingX": "18px",
    "appPaddingBottom": "110px",
    "cardGap": "14px",
    "rowGap": "6px"
  },
  "shadow": {
    "cardRest": "0 5px 0 var(--edge)",
    "cardPressed": "0 1px 0 var(--edge)",
    "playButton": "0 3px 0 var(--cd)",
    "streak": "0 2px 0 var(--edge)"
  },
  "motion": {
    "cardPress": { "durationMs": 120, "easing": "cubic-bezier(.3,1.6,.5,1)" },
    "cardDrop": { "durationMs": 500, "easing": "cubic-bezier(.3,1.5,.5,1)", "staggerMs": 70 },
    "toast": { "durationMs": 250, "easing": "ease" }
  }
}
